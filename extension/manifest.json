{
  "manifest_version": 3,
  "name": "Japanese Weave",
  "version": "0.8.1",
  "description": "Swaps a few English words for Japanese on any website, at your Japanese Weave level.",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "nativeMessaging",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/content-loader.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/*.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Japanese Weave",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "intensity-up": {
      "suggested_key": {
        "default": "Alt+Shift+Period"
      },
      "description": "More Japanese on pages for the next 3 hours, up to Full"
    },
    "intensity-down": {
      "suggested_key": {
        "default": "Alt+Shift+Comma"
      },
      "description": "Less Japanese on pages for the next 3 hours, down to Off"
    }
  }
}
